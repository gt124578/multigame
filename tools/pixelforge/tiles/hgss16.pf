# rivage nord : herbe en haut, berge, transparent en bas
tile rivage_N 16x16
  gggggggggggggggg
  ggGgGggggggghggg
  gggGgggggggggggg
  gggggggggGgGgggg
  ggggggggggGggggg
  ddgddddddgdddddd
  sssSssssssssSsss
  SSSSSSSSSSSSSSSS
  EEEEEEEEEEEEEEEE
  .f......f.......
  ................
  ................
  ................
  ................
  ................
  ................

derive rivage_S = flipv rivage_N
derive rivage_O = rot90 rivage_N
derive rivage_E = rot270 rivage_N

# coin concave nord-ouest d'un lac
tile coin_NO 16x16
  gggggggggggggggg
  ggGgGggggggghggg
  gggGgggggggggggg
  gggggggggGgGgggg
  ggggggggggGggggg
