# Odyssée — sol à l'échelle exacte HGSS : tuiles 16x16 (écran DS 256x192 = 16x12 cases).
# Rendu : python3 tools/pixelforge/render.py tools/pixelforge/tiles/hgss16.pf --out out16 --preview

palette
  . = transparent
  g = #78c860
  G = #58a848
  h = #94d878
  d = #2e7a34
  s = #ecd9a2
  S = #c8ac6c
  E = #2a64c4
  w = #4a98f4
  W = #3482e0
  b = #8ccaff
  f = #f2f8ff
  t = #d8b878
  T = #b89858
  u = #c8a868

# herbe : touffes en « v » comme sur les routes de Johto
tile herbe 16x16
