# Odyssée — tuiles nature 32x32, palette limitée façon HGSS.
# Rendu : python3 tools/pixelforge/render.py tools/pixelforge/tiles/nature.pf --out out --preview

palette
  . = transparent
  g = #68c058
  G = #4c9e44
  h = #94de7e
  d = #2e7a34
  s = #ecd9a2
  S = #cdb374
  E = #2a64c4
  w = #4a98f4
  W = #3482e0
  b = #8ccaff
  f = #f2f8ff
  v = #46a040
  V = #2a6e30

